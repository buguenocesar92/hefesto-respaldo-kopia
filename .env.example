# =============================================================================
# Hefesto Studio - kit respaldo Kopia
# ARCHIVO DE EJEMPLO. Copiar a `.env` y reemplazar TODOS los valores.
# `.env` esta en `.gitignore` y NUNCA debe subirse a un repositorio.
# =============================================================================
#
# -----------------------------------------------------------------------------
# COMO GENERAR LOS SECRETOS
# -----------------------------------------------------------------------------
# En un servidor Ubuntu/Debian, sin instalar nada:
#
#   # Clave del repositorio (la mas importante de todas)
#   openssl rand -base64 48 | tr -d '\n=' ; echo
#
#   # Contrasenas de la interfaz y del control del servidor de repositorio
#   openssl rand -base64 32 | tr -d '\n=' ; echo
#
# Instalar `openssl` si hace falta:  sudo apt-get install -y openssl
#
# REGLAS:
#   * La clave del repositorio NO debe llevar `=` ni saltos de linea: se pasa
#     tal cual a `kopia repository create` como variable de entorno.
#   * No reutilices la clave del repositorio como contrasena de la interfaz.
#   * La clave del repositorio debe quedar en un gestor de contrasenas
#     (Bitwarden, KeePass, 1Password), NO solo en este servidor.
#     Ver docs/05-RESPALDOS-Y-RESTAURACION.md, seccion "La unica clave".
# =============================================================================


# -----------------------------------------------------------------------------
# IDENTIFICACION DEL SERVICIO
# -----------------------------------------------------------------------------
# Nombre logistico. Solo aparece en etiquetas de contenedor. Sin secretos.
KOPIA_TIMEZONE=America/Santiago
KOPIA_SERVER_NOMBRE=respaldos-hefesto


# -----------------------------------------------------------------------------
# PUERTO Y EXPOSICION
# -----------------------------------------------------------------------------
# Puerto del Kopia Repository Server. 51515 es el valor por defecto de upstream
# (ver cli/command_server.go: `--address` por defecto `http://127.0.0.1:51515`).
PUERTO_KOPIA=51515

# IP del host a la que se publica el puerto.
#
# `127.0.0.1` = solo la propia maquina (recomendado: se accede por tunel SSH
#               o por el proxy de Coolify).
# `0.0.0.0`   = queda escuchando en todas las interfaces del servidor.
#               SOLO si ademas hay TLS y un proxy delante. Hefesto no lo
#               recomienda para un primer despliegue.
#
# NUNCA pongas una IP publica con el puerto abierto al mundo sin TLS.
KOPIA_BIND_HOST=127.0.0.1


# -----------------------------------------------------------------------------
# SECRETOS  --  TODAS OBLIGATORIAS EN PRODUCCION
# -----------------------------------------------------------------------------
# # OBLIGATORIA. Clave del repositorio: cifra y descifra todos los respaldos.
# # Si se pierde, los respaldos quedan inservibles aunque los datos esten
# # intactos en el bucket. No es recuperable. Guardar en un gestor de
# # contrasenas aparte del servidor. No es la contrasena del bucket.
KOPIA_PASSWORD=cambie-esto-por-openssl-rand-base64-48

# # OBLIGATORIA. Contrasena de la interfaz web (KopiaUI) y de la API.
# # La usa el healthcheck del contenedor via `kopia server status`.
KOPIA_SERVER_PASSWORD=cambie-esto-por-openssl-rand-base64-32

# # OBLIGATORIA. Usuario de la interfaz web. Upstream usa `kopia` por defecto.
KOPIA_SERVER_USERNAME=admin-respaldos

# # OBLIGATORIA. Contrasena de control del servidor de repositorio
# # (`kopia server refresh`, administracion de usuarios). Es una cuenta
# # distinta de la de la interfaz.
KOPIA_SERVER_CONTROL_PASSWORD=cambie-esto-por-openssl-rand-base64-32

# # OBLIGATORIA. Usuario de control. Upstream usa `server-control` por defecto.
KOPIA_SERVER_CONTROL_USERNAME=control-respaldos


# -----------------------------------------------------------------------------
# ALMACENAMIENTO (usado por crear-repositorio.sh)
# -----------------------------------------------------------------------------
# Tipo de backend del repositorio. Valores verificados en la documentacion:
#   s3 | azure | b2 | gcs | gdrive | webdav | sftp | rclone | filesystem | server
# Fuente: https://kopia.io/docs/repositories/
KOPIA_STORAGE_TYPE=s3

# --- Para KOPIA_STORAGE_TYPE=s3 (o cualquiera compatible con la API S3) ---
# # OBLIGATORIA si el tipo es s3
KOPIA_S3_BUCKET=cambie-esto-bucket-de-respaldos
KOPIA_S3_ENDPOINT=
KOPIA_S3_REGION=
KOPIA_S3_ACCESS_KEY=cambie-esto-access-key
KOPIA_S3_SECRET_ACCESS_KEY=cambie-esto-secret-access-key

# --- Para filesystem (solo laboratory / demostracion) ---
# Un repositorio en el mismo servidor que respalda NO protege de la perdida
# del servidor. Ver docs/08-SERVICIOS-COMERCIALES.md.
KOPIA_FILESYSTEM_PATH=/srv/kopia/repositorio

# --- Para los otros backends ---
# Solo se rellenan si cambias KOPIA_STORAGE_TYPE. Los nombres exactos y los
# flags de creacion estan en docs/03-VARIABLES-Y-COMO-OBTENERLAS.md.
#   azure  : KOPIA_AZURE_CONTAINER, KOPIA_AZURE_STORAGE_ACCOUNT,
#            KOPIA_AZURE_STORAGE_KEY  (o KOPIA_AZURE_SAS_TOKEN)
#   b2     : KOPIA_B2_BUCKET, KOPIA_B2_KEY_ID, KOPIA_B2_KEY
#   gcs    : KOPIA_GCS_BUCKET, KOPIA_GCS_CREDENTIALS_FILE
#   webdav : KOPIA_WEBDAV_URL, KOPIA_WEBDAV_USERNAME, KOPIA_WEBDAV_PASSWORD
#   sftp   : KOPIA_SFTP_PATH, KOPIA_SFTP_HOST, KOPIA_SFTP_USERNAME,
#            KOPIA_SFTP_PASSWORD  (o KOPIA_SFTP_KEYFILE)
#
# Los backends `rclone` y `gdrive` NO estan soportados por los scripts de este
# kit: upstream los marca como experimentales.
# Fuente: https://kopia.io/docs/repositories/


# -----------------------------------------------------------------------------
# POLITICA DE RETENCION INICIAL (aplicada por crear-repositorio.sh)
# -----------------------------------------------------------------------------
# Fuente de los nombres de opcion: `kopia policy set --help` y la guia
# https://kopia.io/docs/getting-started/#policies
POLITICA_KEEP_LATEST=7
POLITICA_KEEP_HOURLY=24
POLITICA_KEEP_DAILY=14
POLITICA_KEEP_WEEKLY=8
POLITICA_KEEP_MONTHLY=6
POLITICA_KEEP_ANNUAL=2

# Compresion. Upstream la tiene DESACTIVADA por defecto
# (https://kopia.io/docs/faqs/#how-do-i-enable-compression). `zstd` es la
# recomendacion habitual de Kopia. Valores admitidos: none, deflate-*, gzip*,
# pgzip*, s2-*, zstd, zstd-better-compression, zstd-fastest.
POLITICA_COMPRESSION=zstd

# Identidad del origen. Ver docs/03: si cambia el hostname, la maquina aparece
# como un origen nuevo y las instantaneas viejas dejan de purgarse.
# Poner un valor estable y documentado aca.
KOPIA_IDENTITY_USER=hefesto
KOPIA_IDENTITY_HOST=srv-respaldos

# Dias entre mantenimientos completos. Vacio = default de upstream (24 h).
# OJO: si usas Object Lock, el `full-interval` debe ser al menos UN DIA mas
# corto que el `retention-period`, o Kopia no renueva las fechas de retencion.
# Fuente: https://kopia.io/docs/advanced/maintenance/
KOPIA_MAINTENANCE_DIAS=


# -----------------------------------------------------------------------------
# RESPALDO (usado por respaldar.sh)
# -----------------------------------------------------------------------------
# Rutas a respaldar, separadas por ESPACIOS. Se pueden sobreescribir por
# linea de comandos con:  ./scripts/respaldar.sh --fuente /otra/ruta
RUTAS_RESPALDO="/srv/datos /srv/documentos"

# Segundos de espera despues de pausar los escritores, para que terminen de
# escribir antes de que Kopia lea.
PAUSA_SEGUNDOS=5


# -----------------------------------------------------------------------------
# VERIFICACION (usado por verificar.sh)
# -----------------------------------------------------------------------------
# Porcentaje de archivos que se descargan, descifran y descomprimen para
# detectar bit rot. 0 = solo verifica estructura y existencia de blobs.
# Upstream recomienda 100 mensual y al menos 1 diario.
# Fuente: https://kopia.io/docs/advanced/consistency/
VERIFICAR_PORCENTAJE=1
VERIFICAR_PARALELISMO=4
VERIFICAR_MAX_ERRORES=1


# -----------------------------------------------------------------------------
# TLS (opcional, solo si expones el servidor fuera del host)
# -----------------------------------------------------------------------------
# El uso de TLS NO se activa con una variable: se activa agregando el override
#   docker compose -f compose.yaml -f compose.tls.yaml up -d
# Las rutas de los certificados (/app/config/tls/kopia.crt y .key) estan fijadas
# en compose.tls.yaml. Ver docs/02-INSTALACION-COOLIFY.md y config/README.md.
#
# Esta variable SI la usa el override: la huella del certificado, que el
# healthcheck pasa a `kopia server status` para anclar el certificado.
# NO es un secreto: upstream la imprime en pantalla al generar el certificado.
#   openssl x509 -in config/tls/kopia.crt -noout -fingerprint -sha256 \
#     | sed 's/://g' | cut -f 2 -d =
KOPIA_TLS_FINGERPRINT=